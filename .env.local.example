# Copia este ficheiro para .env.local e preenche com as credenciais do
# projeto Supabase (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só para uso no servidor (Server Actions/Route Handlers) — nunca expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com → API Keys (conta paga por utilização, separada do plano Claude.ai)
ANTHROPIC_API_KEY=

# Só o email definido aqui entra em /admin/logs (registo interno das leituras).
ADMIN_EMAIL=
